# RouteWise AI — environment template.
# Copy to `.env` in the repository root (it's git-ignored) and fill in real values there.
# Never put real secrets in this file.

APP_ENV=development
LOG_LEVEL=INFO
# Logging of prompt/response content. Keep false unless you are debugging locally.
LOG_CONTENT=false

# --- Database (Neon PostgreSQL) ---
# Neon console -> project "routewise-ai" -> Connect -> copy the connection string.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require&channel_binding=require

# Optional: a DISPOSABLE database for PostgreSQL tests (e.g. a Neon branch named "test").
# Tests DROP and recreate the schema here. Must not equal DATABASE_URL.
# TEST_DATABASE_URL=

# --- Security ---
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Admin endpoints stay disabled until ADMIN_TOKEN is set. Production requires 32+ characters.
ADMIN_TOKEN=<generate-a-random-token>
# Mixed into API-key hashes. Changing it invalidates every tenant key. Production: 32+ characters.
API_KEY_PEPPER=<generate-a-random-pepper>
ADMIN_SESSION_TTL_S=28800
ADMIN_LOGIN_ATTEMPTS_PER_MIN=5
# Comma-separated list of dashboard origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# --- Providers ---
# Paid usage is not supported; the app refuses to start if this is true.
ALLOW_PAID_MODELS=false

MOCK_PROVIDER_ENABLED=true

# Groq. Create a free key at console.groq.com yourself; never paste it in chat.
GROQ_ENABLED=false
GROQ_API_KEY=
# "free" declares the key is on Groq's Free plan ($0), so Groq charges are labelled free_tier.
GROQ_BILLING_PLAN=unknown

# OpenRouter free (":free") models only. Limited fallback, ranked after Groq.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
# Defaults until the account's real daily limit is read from OpenRouter at startup.
OPENROUTER_FREE_RPM=20
OPENROUTER_FREE_RPD=50

# Ollama (local only; must be localhost; refused in production).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# --- Resilience ---
REQUEST_DEADLINE_S=60
PROVIDER_TIMEOUT_S=30
RETRY_BACKOFF_BASE_S=0.5
RETRY_BACKOFF_CAP_S=4
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_S=30
STALE_RESERVATION_S=600
# Fetch each provider's live model list at startup; models missing from it are excluded.
VERIFY_MODEL_CATALOG=true
